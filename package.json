{
  "name": "element-shooter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "2D physics-based arena shooter — vanilla JS browser game",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .prettierrc \"**/*.{js,css,html,md,json,yml,yaml}\"",
    "format:check": "prettier --check .prettierrc \"**/*.{js,css,html,md,json,yml,yaml}\"",
    "test": "vitest run",
    "check:dead-code": "knip",
    "check:complexity": "eslint js/ --rule 'complexity: [warn, { max: 20 }]' --max-warnings 0 --format stylish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-unicorn": "72.0.0",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "knip": "6.29.0",
    "lint-staged": "16.1.6",
    "prettier": "3.9.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.11",
    "nanoid": "3.3.18",
    "smol-toml": "1.7.1",
    "source-map-js": "1.2.2",
    "vite": "8.1.6",
    "zod": "4.6.6"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "license": "MIT"
}
